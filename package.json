{
  "name": "firebase-tour",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:infrastructure": "jest --runInBand --testPathPattern=infrastructure",
    "check-progress": "node scripts/check-progress.js",
    "check-progress:report": "node scripts/check-progress.js --report-only",
    "verify": "npm run check-progress && npm test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "expo": "~57.0.31",
    "expo-asset": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "firebase": "^11.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/parser": "^7.26.10",
    "@babel/traverse": "^7.26.10",
    "@testing-library/react-native": "^13.0.1",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "~57.0.16",
    "expo-modules-core": "~57.0.24",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3"
  }
}
