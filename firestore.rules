rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['title', 'completed', 'authorId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['title', 'completed', 'authorId', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.completed == false
        && request.resource.data.createdAt == request.time;
      // Any signed-in participant can complete a shared task. Preserve its author,
      // creation time, and title; updates may change only the completion flag.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed'])
        && request.resource.data.completed is bool;
    }
  }
}
